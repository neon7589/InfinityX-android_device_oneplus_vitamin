 .../POSFrameworksResTarget/Android.bp         | 10 +++++++
 .../AndroidManifest.xml                       | 15 ++++++++++
 .../res/values/config.xml                     | 29 +++++++++++++++++++
 .../LineageSDKResTarget/res/values/config.xml | 12 --------
 5 files changed, 57 insertions(+), 12 deletions(-)
 create mode 100644 overlay-aosp/POSFrameworksResTarget/Android.bp
 create mode 100644 overlay-aosp/POSFrameworksResTarget/AndroidManifest.xml
 create mode 100644 overlay-aosp/POSFrameworksResTarget/res/values/config.xml

diff --git a/device.mk b/device.mk
index 4199219..c3af75f 100644
--- a/device.mk
+++ b/device.mk
@@ -258,6 +258,9 @@ PRODUCT_PACKAGES += \
     LineageSettingsProviderResTarget \
     PowerOffAlarmResTarget
 
+PRODUCT_PACKAGES += \
+    POSFrameworksResTarget
+
 # Partitions
 PRODUCT_USE_DYNAMIC_PARTITIONS := true
 
diff --git a/overlay-aosp/POSFrameworksResTarget/Android.bp b/overlay-aosp/POSFrameworksResTarget/Android.bp
new file mode 100644
index 0000000..ce7e247
--- /dev/null
+++ b/overlay-aosp/POSFrameworksResTarget/Android.bp
@@ -0,0 +1,10 @@
+//
+// Copyright (C) 2024 The LineageOS Project
+//
+// SPDX-License-Identifier: Apache-2.0
+//
+
+runtime_resource_overlay {
+    name: "POSFrameworksResTarget",
+    product_specific: true,
+}
diff --git a/overlay-aosp/POSFrameworksResTarget/AndroidManifest.xml b/overlay-aosp/POSFrameworksResTarget/AndroidManifest.xml
new file mode 100644
index 0000000..0cc6505
--- /dev/null
+++ b/overlay-aosp/POSFrameworksResTarget/AndroidManifest.xml
@@ -0,0 +1,15 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+     Copyright (C) 2025 The PixelOS Project
+    
+     SPDX-License-Identifier: Apache-2.0
+-->
+<manifest xmlns:android="http://schemas.android.com/apk/res/android"
+    package="android.overlay.pos.vitamin">
+
+    <application android:hasCode="false" />
+    <overlay
+        android:isStatic="true"
+        android:priority="350"
+        android:targetPackage="android" />
+</manifest>
diff --git a/overlay-aosp/POSFrameworksResTarget/res/values/config.xml b/overlay-aosp/POSFrameworksResTarget/res/values/config.xml
new file mode 100644
index 0000000..ef844fa
--- /dev/null
+++ b/overlay-aosp/POSFrameworksResTarget/res/values/config.xml
@@ -0,0 +1,29 @@
